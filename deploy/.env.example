# Copy this file to .env and replace every placeholder before starting.
POSTGRES_DB=enshi_museum
POSTGRES_USER=enshi_app
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

MINIO_ROOT_USER=replace_with_a_minio_username
MINIO_ROOT_PASSWORD=replace_with_a_long_random_minio_password
MINIO_ACCESS_KEY=replace_with_a_minio_username
MINIO_SECRET_KEY=replace_with_a_long_random_minio_password
MINIO_SECURE=false
MINIO_BUCKET=enshi-media

ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
AUTH_SECRET=replace_with_a_long_random_auth_secret

# FRONTEND_ORIGIN is the address visitors use. MINIO_PUBLIC_ENDPOINT is host:port.
FRONTEND_ORIGIN=http://YOUR_HOST_IP
MINIO_PUBLIC_ENDPOINT=YOUR_HOST_IP:9000
FRONTEND_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_IMAGE=enshi-museum/backend:1.0.0
FRONTEND_IMAGE=enshi-museum/frontend:1.0.0

EXTERNAL_MODEL_CALLS_ENABLED=false
EMBEDDING_INDEXING_ENABLED=false
HYBRID_RETRIEVAL_ENABLED=false
CHAT_GENERATION_ENABLED=false
WEB_SEARCH_ENABLED=false
