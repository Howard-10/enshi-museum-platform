# Copy this file to .env before starting Docker Compose.

# PostgreSQL + pgvector
POSTGRES_DB=enshi_museum
POSTGRES_USER=enshi_app
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (object storage)
MINIO_ROOT_USER=change_this_minio_user
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=enshi-media

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# These addresses are for a backend started directly on your Windows computer.
# If the backend is later added to docker-compose, change localhost to the
# corresponding service names: postgres, redis and minio.
DATABASE_URL=postgresql+asyncpg://enshi_app:change_this_database_password@127.0.0.1:5432/enshi_museum
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change_this_minio_user
MINIO_SECRET_KEY=change_this_minio_password
MINIO_SECURE=false

# Local management console. Use a long random value; never commit the real
# value. Open http://localhost:8080/admin and enter the same value there.
ADMIN_API_TOKEN=replace_with_a_long_local_admin_token

# Add a provider/model only after the school confirms the embedding solution.
# The code will use an OpenAI-compatible API first; keep these blank until confirmed.
LLM_API_KEY=
LLM_BASE_URL=
CHAT_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_PROFILE_ID=school_embed_title_v2
# content_only_v1 preserves the old strategy; title_and_content_v2 embeds
# the source title with each chunk, which is recommended for a new profile.
EMBEDDING_TEXT_TEMPLATE=title_and_content_v2
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=
# Safety switch: leave false until the project owner approves real model calls.
EXTERNAL_MODEL_CALLS_ENABLED=false
# The next three switches are deliberately separate. Enable them only in the
# documented Phase 1 -> 5 order after each previous phase passes acceptance.
EMBEDDING_INDEXING_ENABLED=false
HYBRID_RETRIEVAL_ENABLED=false
CHAT_GENERATION_ENABLED=false

# External web search remains disabled until an approved Tavily key and monthly
# budget are configured. The backend never calls Tavily while this is false.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MONTHLY_REQUEST_LIMIT=0
WEB_SEARCH_MAX_REQUESTS_PER_ANSWER=2
WEB_SEARCH_ALLOWED_DOMAINS=ncha.gov.cn,mct.gov.cn,hubei.gov.cn,chnmuseum.cn
